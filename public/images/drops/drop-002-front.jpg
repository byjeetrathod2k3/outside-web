<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1250" width="100%" height="100%">
  <rect width="1000" height="1250" fill="#F8F6F2" />
  
  <!-- Subtle Architectural Grid -->
  <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
    <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#EAE6DF" stroke-width="1" />
  </pattern>
  <rect width="1000" height="1250" fill="url(#grid)" />

  <!-- T-shirt Silhouette -->
  <g transform="translate(180, 160)">
    <!-- Shadow -->
    <path d="M 170 50 Q 320 80 470 50 L 610 180 L 520 270 L 470 220 L 470 780 L 170 780 L 170 220 L 120 270 L 30 180 Z" fill="#000000" fill-opacity="0.06" transform="translate(10, 15)" filter="blur(8px)" />
    <!-- Main Shirt Body -->
    <path d="M 170 50 Q 320 80 470 50 L 610 180 L 520 270 L 470 220 L 470 780 L 170 780 L 170 220 L 120 270 L 30 180 Z" fill="#E2E8DD" stroke="#D1CCC2" stroke-width="2" />
    <!-- Ribbed Collar -->
    <path d="M 250 65 Q 320 120 390 65" stroke="#D91E2A" stroke-width="4" fill="none" />
    <path d="M 240 60 Q 320 115 400 60" stroke="#BBB5A8" stroke-width="2" fill="none" />

    <!-- Graphic / Typography -->
    <text x="320" y="320" fill="#2D3A29" font-family="sans-serif" font-weight="900" font-size="28" letter-spacing="3" text-anchor="middle">BOTANICAL ARCHITECTURE</text>
    <line x1="280" y1="340" x2="360" y2="340" stroke="#D91E2A" stroke-width="3" />
    <text x="320" y="375" fill="#78716C" font-family="monospace" font-size="12" letter-spacing="4" text-anchor="middle">DROP 002 // SAGE TERRY</text>
    
    <!-- Hem Stitched Tag -->
    <rect x="175" y="740" width="45" height="30" fill="#EAE5DC" stroke="#C4BCAD" stroke-width="1" />
    <text x="197" y="760" fill="#D91E2A" font-family="monospace" font-size="8" font-weight="bold" text-anchor="middle">OUT</text>
  </g>

  <!-- Editorial Card Badges -->
  <text x="60" y="80" fill="#78716C" font-family="monospace" font-size="14" letter-spacing="4">GUJARAT ATELIER // SPEC-280</text>
  <text x="60" y="115" fill="#18181B" font-family="sans-serif" font-weight="900" font-size="32" letter-spacing="2">BOTANICAL ARCHITECTURE</text>
  
  <line x1="60" y1="1180" x2="940" y2="1180" stroke="#E5E0D6" stroke-width="1" />
  <text x="60" y="1215" fill="#A8A29E" font-family="monospace" font-size="12" letter-spacing="3">100% COMBED COTTON · 280 GSM FRENCH TERRY · SERIALIZED RUN</text>
  <text x="940" y="1215" fill="#D91E2A" font-family="monospace" font-size="12" font-weight="bold" letter-spacing="3" text-anchor="end">OUTSIDE INDIA</text>
</svg>