# ==========================================
# OUTSIDE (www.outside.in) ENVIRONMENT CONFIG
# ==========================================

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outside_db?schema=public"

# Auth & Session Security (Min 32 characters)
AUTH_SECRET="outside_super_secure_secret_key_production_32chars_min"

# Admin-Managed Credential Encryption (AES-256-GCM 32-byte Hex Key)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Default India GST Configuration
NEXT_PUBLIC_GST_ORIGIN_STATE_CODE="24"
NEXT_PUBLIC_GST_DEFAULT_HSN="61091000"
NEXT_PUBLIC_GST_THRESHOLD_INR="2500"

# ==========================================
# INDIAN PAYMENT GATEWAY CHOICES (CHOOSE ONE)
# ==========================================
# 1. Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# 2. Cashfree Payments
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

# 3. PhonePe
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"

# Cloud Storage (Optional Cloudflare R2 / AWS S3)
S3_ENDPOINT=""
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
